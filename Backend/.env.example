# ===== SERVER =====
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://dinhvietquyet.website
BACKEND_PUBLIC_URL=https://dinhvietquyet.website
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=1
# Trợ lý chat: thời gian chờ Groq ngắn, không thử lại (hết giờ thì dùng câu trả lời dựng bằng luật).
GROQ_CHAT_TIMEOUT_MS=4000
GROQ_CHAT_MAX_RETRIES=0
# Mặc định chỉ câu kể chuyện (kỷ niệm) mới nhờ LLM diễn đạt lại; đặt "all" để bật cho mọi câu.
CHATBOT_LLM_REWRITE=narrative
# Ghi log câu trả lời chậm hơn ngưỡng này (ms) để theo dõi.
CHATBOT_SLOW_MS=3000
# Giới hạn gọi /api/ai/* theo tài khoản (mặc định 10 lần/phút)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
CHATBOT_MEMORY_TTL_MS=1800000
CHATBOT_MEMORY_MAX_SESSIONS=1000
CHATBOT_RATE_LIMIT_MAX_BUCKETS=5000
CHATBOT_GRAPH_CACHE_MAX_SIZE=100
CHATBOT_PATH_CACHE_MAX_SIZE=5000
CHATBOT_MAX_SIBLING_PAIR_MATERIALIZATION=300
CHATBOT_MAX_HALF_SIBLING_PAIR_MATERIALIZATION=5000

# ===== DATABASE (MySQL - Aiven) =====
DB_HOST=your-db-host.aivencloud.com
DB_PORT=16931
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_USE_PUBLIC_DNS=false
DB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ===== JWT AUTH =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h
# Giới hạn số lần đăng nhập theo IP trong mỗi khung thời gian (tùy chọn)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ===== OAUTH SOCIAL LOGIN =====
BACKEND_URL=https://dinhvietquyet.website
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dinhvietquyet.website/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://dinhvietquyet.website/api/auth/facebook/callback
# Keep empty if Meta rejects the email permission. Set to "email" only after the app has that permission enabled/approved.
FACEBOOK_AUTH_SCOPE=

# ===== EMAIL =====
# Ưu tiên Resend (gửi qua HTTPS; Render chặn cổng SMTP). Để trống thì dùng SMTP bên dưới.
RESEND_API_KEY=
RESEND_FROM="Gia Phả Việt <noreply@your-domain.com>"

# SMTP dự phòng. Gmail: cổng 465 (SSL) hoặc 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Gia Phả Việt <yourgmail@gmail.com>"

# =========================
# SePay
# =========================
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
SEPAY_API_TOKEN=your_sepay_api_token
SEPAY_BANK_BIN=your_bank_bin
SEPAY_BANK_ACCOUNT=your_bank_account_number
SEPAY_ACCOUNT_NAME=YOUR ACCOUNT NAME
SEPAY_QR_TEMPLATE=compact2

# Schema: chạy `npm run migrate` khi deploy. Sau đó đặt true để server không tự ALTER/CREATE lúc request.
DISABLE_RUNTIME_DDL=false
# Chạy migrate tự động khi server khởi động (tiện cho deploy một instance).
RUN_MIGRATIONS_ON_START=false
# Số kết nối tối đa của pool MySQL.
DB_CONNECTION_LIMIT=10
