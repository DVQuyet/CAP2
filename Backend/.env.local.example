# Sao chép file này thành Backend/.env.local khi chạy backend ở máy cá nhân.
# .env.local đã nằm trong .gitignore và được nạp TRƯỚC .env, nên các giá trị dưới đây thắng .env.
# Các biến không ghi ở đây (key Groq, SMTP, SePay...) vẫn lấy từ .env.

NODE_ENV=development
PORT=3000

# Địa chỉ local: đăng nhập Google/Facebook, link mời, link ảnh quay về máy mình thay vì web thật.
FRONTEND_URL=http://localhost:5173
INVITE_FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Không chạy nhắc lịch nền ở máy cá nhân (tránh gửi email/thông báo thật).
DISABLE_BACKGROUND_JOBS=true

# Database RIÊNG cho máy cá nhân (MySQL cài trên máy). Không dùng chung DB Aiven của bản thật.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cap2_dev
DB_SSL=false
