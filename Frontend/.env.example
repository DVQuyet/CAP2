# Sao chép thành .env.local khi cần đổi địa chỉ backend lúc chạy "npm run dev".
# Lưu ý: bản build (npm run build / npm run preview) mặc định gọi backend thật trên Render.
# Muốn bản build ở máy gọi backend local thì tạo .env.production.local với VITE_API_BASE_URL=http://localhost:3000.
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
